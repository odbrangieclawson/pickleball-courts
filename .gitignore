# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source dataset. NOT committed by default - it is ~7.8 MB of records scraped
# from a competitor directory (every source_url points to courtsource.us), and
# whether that belongs in version control is the owner's call, not a default.
# The import pipeline reads it from the repo root. See reports/import-mapping.md.
data.csv

# Per-metro verification worksheets are WORKING FILES that humans fill in.
# The generator is committed; its 200 generated outputs are not, so a
# regenerated blank does not clobber a half-filled worksheet in a diff.
# Regenerate with `npm run verify:build`. Filled-in worksheets belong
# wherever your verification work actually lives, not in a generated dir.
verification/

# Preview renders. Built from UNVERIFIED rows to judge the template, never
# deployed and never publishable. Regenerate with `npm run preview:city`.
reports/preview-*.html

# Supabase export is generated — regenerate with `npm run export:supabase`.
# Committed anyway: it is small, it is the handoff artefact, and a diff on it
# is a readable record of what changed in the verified set.
